# Normally generated by ./install.sh. For a manual setup: cp .env.example .env,
# fill in the values, then: docker compose up -d --build
# Values are double-quoted; do not use " $ ` or \ inside them.

COMPOSE_PROJECT_NAME="ai-gateway"
# Optional services: cluster (web-chat Chrome instances), ollama, caddy (HTTPS on 80/443)
COMPOSE_PROFILES="cluster,caddy"
# Add docker-compose.gpu.yml for Ollama with an NVIDIA GPU
COMPOSE_FILE="docker-compose.yml"

SF_BRAND_NAME="AI Gateway"
SF_ASSISTANT_NAME="AI Gateway"
SF_DEFAULT_LANG="uz"
SF_SITE_URL="https://ai.example.com"
SF_API_URL="https://ai.example.com/v1"
# 0 only for plain-http test setups
SF_COOKIE_SECURE="1"

# Used by the caddy profile (./install.sh writes the Caddyfile)
SITE_DOMAIN="ai.example.com"
API_DOMAIN=""
ACME_EMAIL=""

# Host binding of the API container
API_BIND="127.0.0.1"
API_PORT="8310"
# Raw VNC on 127.0.0.1 for SSH tunnels: one port per Chrome instance, in order.
# Instance 0 is on the first port of the range, instance 1 on the next, and so on.
VNC_PORTS="15900-15909"

# Ollama: http://ollama:11434 (bundled) or e.g. http://host.docker.internal:11434
SF_UPSTREAM_URL="http://ollama:11434"
# One Chrome instance per channel, in order: instance 0, 1, ...
# Known: gemini qwen deepseek chatgpt zai grok deepai genspark chatbotapp chatbotchatapp
SF_CHROME_CHANNELS="gemini"

# DeepSeek direct browserless API (bypasses Chrome automation when token is provided)
DEEPSEEK_USER_TOKEN=""
SF_DEEPSEEK_AUTO_CLEANUP="1"

# Secrets - generate with: openssl rand -hex 24
DB_MIGRATOR_PASSWORD=""
DB_APP_PASSWORD=""
CLUSTER_API_KEY=""
SF_VNC_PASSWORD=""
